<Window
    x:Class="FileCryptoTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FileCryptoTool // 文件加密/解密工具">

    <!-- 根容器：允许从外部拖入文件 -->
    <Grid
        Background="{StaticResource AppBackground}"
        Padding="28,22"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 标题区 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="6" Background="{StaticResource Accent}">
                    <SymbolIcon Symbol="OpenFile" Foreground="White" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FileCryptoTool" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="文件加密 / 解密工具" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== 拖放区 ===== -->
        <Border
            Grid.Row="1"
            Background="{StaticResource PanelBackground}"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{StaticResource Hairline}"
            Padding="20,24"
            Margin="0,0,0,20">
            <Grid>
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <SymbolIcon Symbol="OpenFile" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                    <TextBlock Text="拖入文件到此处" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="支持任意文件，拖入后自动识别并生成输出路径" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                    <Button
                        x:Name="SelectInputButton"
                        Content="浏览文件..."
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnSelectInputClick"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 输入文件 ===== -->
        <TextBlock Grid.Row="2" Text="输入文件" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
        <TextBox
            x:Name="InputPathTextBox"
            Grid.Row="3"
            IsReadOnly="True"
            PlaceholderText="拖入文件，或点击上方“浏览文件…”"
            Margin="0,0,0,14" />

        <!-- ===== 输出路径 ===== -->
        <TextBlock Grid.Row="4" Text="输出路径" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
        <Grid Grid.Row="5" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="OutputPathTextBox"
                IsReadOnly="True"
                PlaceholderText="根据输入文件自动生成，可手动修改"
                Grid.Column="0" />
            <Button
                x:Name="SelectOutputButton"
                Content="保存到..."
                Click="OnSelectOutputClick"
                Grid.Column="1"
                Margin="10,0,0,0"
                IsEnabled="False" />
        </Grid>

        <!-- ===== 密码 + 操作按钮 ===== -->
        <TextBlock Grid.Row="6" Text="密码" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox
                x:Name="PasswordBox"
                PlaceholderText="输入加密 / 解密密码"
                Grid.Column="0" />
            <Button
                x:Name="EncryptButton"
                Content="加密"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="OnEncryptClick"
                Grid.Column="1"
                Margin="10,0,0,0"
                MinWidth="88"
                IsEnabled="False" />
            <Button
                x:Name="DecryptButton"
                Content="解密"
                Click="OnDecryptClick"
                Grid.Column="2"
                Margin="10,0,0,0"
                MinWidth="88"
                IsEnabled="False" />
        </Grid>

        <!-- ===== 进度条 ===== -->
        <ProgressBar
            x:Name="OperationProgressBar"
            Grid.Row="8"
            Minimum="0"
            Maximum="1"
            Value="0"
            Visibility="Collapsed"
            Margin="0,18,0,0" />

        <!-- ===== 状态栏 ===== -->
        <Border
            Grid.Row="9"
            BorderThickness="0,1,0,0"
            BorderBrush="{StaticResource Hairline}"
            Margin="0,16,0,0"
            Padding="0,10,0,0">
            <TextBlock
                x:Name="StatusTextBlock"
                Text="就绪：拖入文件或点击浏览开始。"
                FontSize="12"
                Foreground="{StaticResource StatusInfo}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>

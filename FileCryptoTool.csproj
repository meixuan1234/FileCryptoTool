<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 输出类型为 Windows 可执行文件 -->
    <OutputType>WinExe</OutputType>
    <!-- 目标框架：.NET 8 + Windows 10 19041（WinUI 3 最低要求） -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- 最低支持 Windows 10 17763 -->
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- 根命名空间，与代码中 namespace 保持一致 -->
    <RootNamespace>FileCryptoTool</RootNamespace>
    <!-- 支持的平台架构 -->
    <Platforms>x86;x64;ARM64</Platforms>
    <!-- 运行时标识符 -->
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- 发布配置文件 -->
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <!-- 启用 WinUI 3 -->
    <UseWinUI>true</UseWinUI>
    <!-- 启用 MSIX 打包工具链 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 自包含 .NET 运行时，避免目标机器缺少运行时 -->
    <SelfContained>true</SelfContained>
    <!-- 自包含 Windows App SDK 运行时，避免目标机器缺少 WinUI 3 运行库 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 启用可空引用类型检查 -->
    <Nullable>enable</Nullable>
    <!-- 启用隐式 using -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK：WinUI 3 运行时与控件库 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <!-- Windows SDK 构建工具：提供清单、资源等编译支持 -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
</Project>
